<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 应用基本信息 -->
    <key>CFBundleName</key>
    <string>QuantDashboard</string>
    <key>CFBundleDisplayName</key>
    <string>量化看板</string>
    <key>CFBundleIdentifier</key>
    <string>com.quantdashboard.app</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- 支持的设备方向 -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- 锁定竖屏 -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- 状态栏样式 -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIStatusBarHidden</key>
    <false/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- 启动画面 -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- 全屏模式 -->
    <key>UIRequiresFullScreen</key>
    <true/>

    <!-- 背景模式 -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>processing</string>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>

    <!-- 网络安全配置（允许 HTTP 访问，TrollStore 部署需要） -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- 本地通知权限 -->
    <key>UIUserNotificationsUsageDescription</key>
    <string>量化看板需要通知权限，在指标产生共振信号时向您发送本地告警通知。</string>

    <!-- 后台音频描述 -->
    <key>UIBackgroundModesDescription</key>
    <string>保持 WebSocket 实时行情连接</string>

    <!-- 最低 iOS 版本 -->
    <key>MinimumOSVersion</key>
    <string>15.0</string>

    <!-- 支持暗色模式 -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <!-- GPU 加速（ProMotion 120Hz） -->
    <key>CADisableMinimumFrameDuration</key>
    <true/>
</dict>
</plist>
